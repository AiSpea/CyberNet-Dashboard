# Public hostname (without https://)
CYBERNET_DOMAIN=cybernet.aisp24.com

# Existing production volumes. Do not change these during migration.
NETBIRD_DATA_VOLUME=netbird-crqe4l_netbird_data
NETBIRD_CONFIG_VOLUME=netbird-crqe4l_netbird_config

# Dokploy's shared Traefik network and TLS settings.
DOKPLOY_NETWORK=dokploy-network
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERT_RESOLVER=letsencrypt

# Label embedded in the Dashboard that Dokploy builds from this repository.
CYBERNET_DASHBOARD_VERSION=main

# Embedded IdP public client settings. AUTH_CLIENT_SECRET intentionally does
# not exist: the Dashboard is a downloadable static application.
NETBIRD_AUTH_AUDIENCE=netbird-dashboard
NETBIRD_AUTH_CLIENT_ID=netbird-dashboard
NETBIRD_AUTH_SUPPORTED_SCOPES=openid profile email groups
NETBIRD_TOKEN_SOURCE=accessToken

# Optional self-hosted feature flags.
NETBIRD_LICENSED=false
NETBIRD_AGENT_NETWORK_ONLY=false
NETBIRD_AGENT_NETWORK_ENABLED=false
NETBIRD_CSP=

# CyberNet product, language and support/download links. These are substituted
# into the static Dashboard by the container entrypoint, so Dokploy can change
# them without rebuilding application source.
CYBERNET_PRODUCT_NAME=CyberNet
CYBERNET_DEFAULT_LOCALE=zh-CN
CYBERNET_DOCS_URL=https://github.com/AiSpea/CyberNet-Dashboard#readme
CYBERNET_SUPPORT_URL=https://github.com/AiSpea/CyberNet-Dashboard/issues
CYBERNET_SOURCE_URL=https://github.com/AiSpea/CyberNet-Dashboard
CYBERNET_CLIENT_DOWNLOAD_URL_TEMPLATE=https://cybernet.aisp24.com/downloads?target={target}
CYBERNET_ANDROID_DOWNLOAD_URL=https://cybernet.aisp24.com/downloads?target=android
CYBERNET_IOS_DOWNLOAD_URL=https://cybernet.aisp24.com/downloads?target=ios

# STUN must remain reachable over UDP.
NETBIRD_STUN_PORT=3478
